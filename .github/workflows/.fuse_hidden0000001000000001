name: CI

# The tenancy suite is the one that matters: it runs the real SQL against a real
# Postgres and then tries to cross the boundary between two accounts. Running it
# on every push is the point of having written it.
on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      - name: Lint
        run: npm run lint

      # Tenancy, agent loop, HTTP layer, devices and pairing, and the deployment
      # paths under VERCEL=1. The last is the reason this job blocks a merge:
      # those branches only ever execute in production otherwise.
      - name: Test suites
        run: npm test

      # The interface suite drives the real app in a real browser. It skips
      # itself when there is nothing to drive, so it is installed explicitly
      # here rather than left to chance.
      - name: Install Chromium
        run: npx playwright install --with-deps chromium

      - name: Interface suite
        run: npm run test:ui
        env:
          # test:ui prefers a channel build; this points it at the one just
          # installed so CI does not depend on Chrome being present.
          PLAYWRIGHT_BROWSERS_PATH: '0'

  audit:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      # Advisory, not blocking: a transitive advisory with no patch available
      # should show up in the log, not stop everyone from merging.
      - run: npm audit --audit-level=high
        continue-on-error: true
