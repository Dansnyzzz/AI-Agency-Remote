# ─────────────────────────────────────────────────────────────
# AI Remote — copy to `.env` for local dev, or paste these into
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Everyone signs in with their own email and password — there is no shared
# access code. Set this to a Neon connection string when you deploy
# (Vercel → Storage → Neon fills it in for you). Leave it blank locally and
# AI Remote runs the same Postgres in-process, stored under ./data.
DATABASE_URL=

# POSTGRES_URL is accepted as an alternative and is what some Vercel storage
# integrations set for you. DATABASE_URL wins if both are present, so you do not
# need to set this by hand — it is listed so that finding it already populated
# in the dashboard is not a mystery.
POSTGRES_URL=

# ── Local run ────────────────────────────────────────────────
# Ignored on a deployment, where the platform decides both.

# Port for `npm start`. Default 5173.
PORT=

# Where the in-process Postgres keeps its files. Default ./data. Point it
# somewhere else to keep the cluster outside the repo.
DATA_DIR=

# Same as `npm run share`: expose the local server on a public HTTPS URL so a
# phone off your Wi-Fi can reach it. Off unless set.
TUNNEL=

# ── Secrets ──────────────────────────────────────────────────
# Signs session cookies. Long and random; changing it signs everyone out.
# Generated into .env automatically on the first local run.
SESSION_SECRET=

# Encrypts stored provider API keys. Changing it makes existing ones unreadable.
ENCRYPTION_KEY=

# Authenticates the daily model-library refresh. Vercel Cron sends it for you;
# set any long random string.
CRON_SECRET=

# Signing up needs an email and a password, nothing else. Set this to false on
# a public deployment once your own accounts exist and the door closes behind
# you. The very first account can always be created — otherwise the deployment
# would have no administrator.
ALLOW_SIGNUP=

# ── Email (password resets only) ─────────────────────────────
# There is no signup confirmation step, so this is needed for exactly one
# thing: letting somebody who forgot their password get back in. With neither
# set, the reset link is printed to the server log instead.
#
# Option 1: Resend. Plain HTTPS, works on Vercel, free tier is generous.
RESEND_API_KEY=
# Option 2: any SMTP server, including Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From address. Resend accepts onboarding@resend.dev until you verify a
# domain of your own.
EMAIL_FROM=AI Remote <onboarding@resend.dev>

# ── Usage limits ─────────────────────────────────────────────
# Monthly token cap applied ONLY to accounts riding the deployment-wide API
# key. Anyone using their own key is never limited. Admins can override this
# per person in Settings → People. Leave blank for no default limit.
DEFAULT_MONTHLY_TOKEN_LIMIT=

# ── Provider keys ────────────────────────────────────────────
# In multi-user mode these are a SHARED FALLBACK: any account without its own
# key spends against them. Leave them blank if each person should bring their
# own (Settings → Providers), which is the sane default for more than one user.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Which model `generate_image` calls. Default imagen-4.0-generate-001. It goes
# through Google, so it needs GOOGLE_API_KEY specifically — an OpenRouter key
# cannot stand in for it, and the tool is withheld from accounts without one
# rather than offered and then failing.
IMAGE_MODEL=

# Reliable web search. Without one of these, search scrapes DuckDuckGo, which
# is best-effort and breaks without warning.

# `web_fetch` refuses private addresses — loopback, 10.x, 192.168.x, and the
# 169.254.169.254 cloud metadata service — because the model chooses the URL and
# it reads web pages that can tell it what to fetch next. Set this to true only
# if reaching something on your own network is the actual point (an internal
# wiki, a service on the same host). Off is the answer you get without deciding.
ALLOW_PRIVATE_FETCH=

# Point the OpenAI provider at any OpenAI-compatible server (Ollama, LM Studio,
# vLLM) to run a local model through the same agent loop.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# Sent to OpenRouter for attribution.
PUBLIC_URL=

# ── Local machine access ─────────────────────────────────────
# The folder the file tools work in. Relative paths resolve from here.
#
# Only the starting value. Change it later from Settings → Computers, or just
# ask the assistant to — it moves within about fifteen seconds, with no restart
# and no file to edit on that machine.
WORKSPACE=

# `full` lets the file tools read and write anywhere, matching what run_command
# can already do. A local `npm start` writes `full` here for you on first run;
# blank it to keep the file tools inside WORKSPACE. Either way the shell has
# never been confined, so treat the approval policy as the real control.
FILE_ACCESS=

# Force local tools through the job queue even when running locally, to test
# the worker relay end to end.
WORKER_MODE=

# ── Browser sandbox ──────────────────────────────────────────
# Uses installed Chrome or Edge — no browser download.
#
# Headed by default (a local `npm start` writes `false` here), because headless
# Chrome has no audio device: a video playing in it is silent frames. The sound
# comes out of THIS machine's speakers — it does not travel to the browser tab
# you are watching from, which only receives images.
BROWSER_HEADLESS=

# Keep the window but silence it.
BROWSER_MUTE=

# The window is parked off the edge of the desktop so it is not in your way and
# cannot be closed by accident — sound and frames are unaffected. Set to true to
# put it back on screen where you can watch it directly.
BROWSER_SHOW=

# Which browser the assistant drives. Normally chosen per computer in
# Settings -> Computers; this is only the default for a machine that has never
# been paired.
#
#   sandbox  a fresh browser with an empty profile. Signed in to nothing, which
#            is the safe default and useless behind a sign-in wall.
#   profile  a persistent profile of the worker's own, under DATA_DIR. Sign in
#            once through the live panel and it stays signed in. NOT your own
#            Chrome profile directory: Chrome locks that while it is running, so
#            using it would fail whenever your browser is open.
#   attach   your own running Chrome, over its remote-debugging port. Closest to
#            an extension driving the browser you actually use. Chrome must have
#            been started with --remote-debugging-port (quit it completely
#            first, or the flag is ignored). Nothing is ever closed on the way
#            out — the tabs are yours, this only borrows them.
# BROWSER_MODE=sandbox

# Where `attach` looks for that browser. Default 9222.
# BROWSER_CDP_PORT=9222

# How hard to compress the small picture kept with each browser step in the
# transcript. Default 45. These are illustrations at ~320px wide, not evidence.
# STEP_SHOT_QUALITY=45
#
# Desktop steps get a picture too, but it is the live camera frame rather than a
# capture of its own (~61KB against ~4KB), and deliberately: starting the
# desktop capture host for a one-off shot was measured at 1516ms on Windows,
# which would be added to every desktop action. SCREEN_WIDTH and SCREEN_QUALITY
# below are what decide its size.

# ── Desktop control ──────────────────────────────────────────
# Let the assistant drive real applications: click buttons, type, press keys,
# launch programs.
#
# Windows works as it stands. macOS needs Accessibility rights granting once to
# whichever terminal runs the worker (System Settings → Privacy & Security).
# Linux/X11 needs `xdotool` and `wmctrl`; Wayland needs `ydotool` with access to
# /dev/uinput. The tools say which is missing rather than failing silently.
#
# This is not a sandbox. It shares one mouse and one keyboard with whoever is
# sitting at the machine, and it can reach anything they can. A local
# `npm start` turns it on for you; set it to false to switch it off, and the
# tools vanish from the model's view entirely rather than merely being refused.
DESKTOP_ACCESS=

# ── The quick launcher ───────────────────────────────────────
# `npm run launcher` claims a key across the whole desktop; pressing it opens
# one box to type a question into.

# Default ctrl+shift+Space. Avoid alt+space combinations — input-method editors
# claim those, and a launcher whose key silently does nothing is worse than one
# that asks. On Windows a taken key is detected and the next free fallback used.
LAUNCHER_HOTKEY=

# Where the launcher window points. Defaults to the local app; set it to your
# deployment to drive that instead.
LAUNCHER_URL=

# Path to a Chromium-family browser, if the usual places do not have one.
# Without it the URL goes to the default browser and arrives as an ordinary tab.
LAUNCHER_BROWSER=

# ── The live screen ──────────────────────────────────────────
# Frames stop entirely when nobody has the panel open, so these only cost
# anything while someone is actually watching.

# Desktop mirror frame rate, 0.2 to 20. Default 10. The browser sandbox ignores
# this — it streams from Chrome's compositor and repaints drive the rate.
SCREEN_FPS=

# JPEG quality, 1 to 100. Default 55. Lower is smaller and faster over mobile.
SCREEN_QUALITY=

# Frames are scaled down to this width before encoding. Default 1280. This is
# the biggest lever on both bandwidth and frame rate.
SCREEN_WIDTH=

# Browser sandbox only: send every Nth compositor frame. Default 1. Raise it to
# spend less bandwidth on animation — but note the screencast already fires only
# on repaint, so skipping frames on a page that paints once sends nothing.
SCREEN_EVERY_NTH=

# The "HD" toggle in the screen panel, which is a separate pair of numbers from
# the two above rather than a multiplier of them.
# Scale factor when HD is on, default 2. JPEG quality when HD is on, default 72
# (SCREEN_QUALITY, default 58, is what applies when it is off).
SCREEN_HD_SCALE=
SCREEN_HD_QUALITY=

# ── Worker-only (put these in worker/.env on your PC) ────────
#
# SERVER_URL is the only one you ever write by hand. Run `npm start` — no flags —
# and the machine shows a pairing code; enter that from the Computers button in
# the app's header and the token below is written here for you. Unpair it later
# and it simply asks again with a new code; there is nothing to edit here.
#
# SERVER_URL=https://your-app.vercel.app
# WORKER_TOKEN=<written by the pairing flow — delete it to pair again>
# WORKSPACE=D:\projects
#
# What this computer is called in the app. Defaults to its hostname.
# DEVICE_NAME=Phu's laptop
#
# How many tool jobs the worker runs at once, 1 to 12. Default 4. The agent
# issues independent tool calls together and waits for all of them, so running
# them one at a time turns every fan-out back into a queue — and one
# `browser_wait` then stalls the calls beside it. Raise it if your work is
# mostly waiting on the network; lower it to 1 if you would rather the machine
# only ever did one thing at a time.
# WORKER_CONCURRENCY=4
#
# How long a worker sleeps between polls when the account has had no work for a
# couple of minutes. Set on the SERVER, not the worker — the server is the only
# side that can see whether anybody is waiting.
#
# Default 0 locally, where holding a connection open costs nothing, and 4000 on
# a deployment, where it does not: a 25-second long poll repeated around the
# clock is roughly 3,400 billed function-hours a month spent on an idle laptop.
# The cost of switching it on is that the FIRST tool call after a quiet spell
# can wait up to this long; every call after it is at full speed. Set to 0 to
# turn the behaviour off entirely.
# WORKER_IDLE_SLEEP_MS=4000

# ── Web search ────────────────────────────────────────────────────────
#
# Tried in order, and the first one that answers wins. An engine with no key
# is skipped; DuckDuckGo needs none, so there is always something to fall
# back to. Override the order with SEARCH_ORDER.
#
#   exa         neural search — returns the passage that answers the question
#   duckduckgo  free, no key, paced so it does not get the address blocked
#   tavily      paid fallback
#   brave       paid fallback

EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# The chain, if you want a different one. Default: exa,duckduckgo,tavily,brave
# SEARCH_ORDER=exa,duckduckgo,tavily,brave

# Milliseconds between two DuckDuckGo requests. It has no quota; the limit is
# enforced by blocking the address, so this is what keeps it usable.
# DDG_MIN_INTERVAL_MS=4000
